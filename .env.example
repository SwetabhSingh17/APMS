# ==============================================================================
# APMS (Academic Project Management System) — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Mac / Linux)
#
# TWO WAYS TO CONFIGURE THE DATABASE — either works:
#   A) Set DATABASE_URL only (simplest; used by both the server and drizzle-kit)
#   B) Set the DB_* variables only
# If both are set, DATABASE_URL takes precedence for everything.
# ==============================================================================

# --- Database (Option A: connection string) ---
DATABASE_URL=postgres://postgres:your_password@127.0.0.1:5432/integral_project_hub

# --- Database (Option B: individual values) ---
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=integral_project_hub
# DB_USER=postgres
# DB_PASSWORD=your_password

# --- Server ---
# Port the server will listen on (default: 3000)
PORT=3000

# Environment mode: "development" or "production"
NODE_ENV=production

# --- Session ---
# Secret key for signing session cookies (use a long random string in production)
SESSION_SECRET=change-me-to-a-secure-random-string
